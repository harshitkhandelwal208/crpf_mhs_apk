# Local backend configuration. Never commit real credentials.
ENV=development
DEBUG=false
SQL_ECHO=false

# Use SQLite only for local development. Production validation requires
# PostgreSQL, such as a Neon connection string with sslmode=require.
DATABASE_URL=sqlite:///./sentinel.db
SECRET_KEY=replace-with-at-least-32-random-characters

# Optional comma-separated list or JSON array of browser origins. Android and
# the desktop BFF do not require CORS access.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=15
DB_POOL_RECYCLE_SECONDS=300

# Used only by `python manage.py bootstrap-admin`.
BOOTSTRAP_ADMIN_EMAIL=administrator@example.gov.in
BOOTSTRAP_ADMIN_NAME=CRPF Platform Administrator
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-unique-password
